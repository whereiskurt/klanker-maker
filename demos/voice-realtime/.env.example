# Copy to .env and fill in, then `./run-local.sh` (laptop) — or encrypt these
# into profiles/secrets/voice.enc.yaml for the km sandbox (see README).

# --- STT ---------------------------------------------------------------------
DEEPGRAM_API_KEY=              # https://console.deepgram.com  (nova-3)
# DEEPGRAM_MODEL=nova-3

# --- LLM (pick ONE; Cerebras wins if both are set) ---------------------------
CEREBRAS_API_KEY=             # https://cloud.cerebras.ai  — the reference blog's engine
# GROQ_API_KEY=              # https://console.groq.com   — drop-in fallback
# LLM_MODEL=llama-3.3-70b    # cerebras id; groq: llama-3.3-70b-versatile

# --- TTS ---------------------------------------------------------------------
ELEVENLABS_API_KEY=           # https://elevenlabs.io
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # pick any voice from your library
# ELEVENLABS_MODEL=eleven_flash_v2_5         # lowest-latency ElevenLabs model

# --- Transport / TURN (needed to carry WebRTC audio over a public tunnel) ----
# Easiest: an HF token — FastRTC proxies Cloudflare TURN for free (10GB/mo).
HF_TOKEN=                     # https://huggingface.co/settings/tokens (read)
# Or bring your own Cloudflare TURN key instead of HF_TOKEN:
# TURN_KEY_ID=
# TURN_KEY_API_TOKEN=

# --- misc --------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
# SYSTEM_PROMPT="You are a warm, quick-witted voice assistant..."
